# =============================================================================
# GENAI RESUME AGENT - ENVIRONMENT VARIABLES
# =============================================================================
# This is a comprehensive guide for all environment variables needed for deployment.
# Copy the appropriate sections to your backend/.env and frontend/.env files.
#
# Project Structure:
#   - backend/.env   -> Backend (FastAPI) environment variables
#   - frontend/.env  -> Frontend (React + Vite) environment variables
# =============================================================================


# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# =============================================================================

## SUPABASE CONFIGURATION (REQUIRED)
SUPABASE_URL=your_supabase_project_url          # e.g., https://xxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key             # From Supabase Dashboard > API

## AI SERVICE CONFIGURATION (REQUIRED)
OPENROUTER_API_KEY=your_openrouter_api_key      # From https://openrouter.ai
AI_MODEL=google/gemini-3-flash-preview          # Optional: AI model to use
AI_TEMPERATURE=0.1                               # Optional: 0.0-1.0
AI_MAX_TOKENS=4000                               # Optional: Max response tokens

## CLOUDFLARE R2 STORAGE (REQUIRED)
R2_ACCOUNT_ID=your_cloudflare_account_id        # From Cloudflare Dashboard
R2_ACCESS_KEY_ID=your_r2_access_key_id          # R2 API token
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key  # R2 API secret
R2_BUCKET_NAME=resume-agent-pdfs                # Your R2 bucket name

## APPLICATION SETTINGS
BACKEND_URL=http://localhost:8000               # Your backend API URL
ENVIRONMENT=development                          # development | staging | production
LOG_LEVEL=INFO                                   # DEBUG | INFO | WARNING | ERROR

## PDF GENERATION (Optional)
PDF_PAGE_SIZE=Letter                            # Letter | A4 | Legal
PDF_MARGIN_TOP=0.50in
PDF_MARGIN_BOTTOM=0.19in
PDF_MARGIN_LEFT=0.42in
PDF_MARGIN_RIGHT=0.42in

## JWT & CORS (Optional - use defaults)
JWT_ALGORITHMS=RS256,ES256
JWT_AUDIENCE=authenticated
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
DOWNLOAD_URL_EXPIRY=3600


# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# =============================================================================

## SUPABASE CONFIGURATION (REQUIRED)
VITE_SUPABASE_URL=your_supabase_project_url     # Same as backend SUPABASE_URL
VITE_SUPABASE_KEY=your_supabase_anon_key        # Same as backend SUPABASE_KEY

## BACKEND API (REQUIRED)
VITE_BACKEND_URL=http://localhost:8000          # Your backend API URL


# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# 
# 1. SUPABASE SETUP:
#    □ Create Supabase project at https://supabase.com
#    □ Copy SUPABASE_URL and SUPABASE_KEY from Settings > API
#    □ Database tables are auto-configured (resume_history, resume_preferences)
#    □ Enable authentication providers (Email, OAuth, etc.)
#
# 2. CLOUDFLARE R2 SETUP:
#    □ Create Cloudflare account at https://cloudflare.com
#    □ Create R2 bucket named "resume-agent-pdfs" (or custom name)
#    □ Generate API token from R2 > Manage R2 API Tokens
#    □ Copy Account ID, Access Key ID, and Secret Access Key
#
# 3. OPENROUTER SETUP:
#    □ Sign up at https://openrouter.ai
#    □ Add credits to your account
#    □ Generate API key from Settings
#    □ Test with google/gemini-3-flash-preview or other models
#
# 4. BACKEND DEPLOYMENT:
#    □ Copy backend/.env.example to backend/.env
#    □ Fill in all REQUIRED variables
#    □ Adjust optional settings as needed
#    □ Deploy to your hosting platform (Railway, Render, Fly.io, etc.)
#    □ Update BACKEND_URL with production URL
#
# 5. FRONTEND DEPLOYMENT:
#    □ Copy frontend/.env.example to frontend/.env
#    □ Fill in SUPABASE_URL, SUPABASE_KEY, and BACKEND_URL
#    □ Build: npm run build
#    □ Deploy to hosting platform (Vercel, Netlify, Cloudflare Pages, etc.)
#
# 6. PRODUCTION SETTINGS:
#    □ Set ENVIRONMENT=production in backend
#    □ Configure CORS_ORIGINS with your frontend domain
#    □ Set up proper logging and monitoring
#    □ Test end-to-end authentication and resume generation
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ⚠️  NEVER commit .env files to version control
# ⚠️  Use environment-specific .env files (.env.development, .env.production)
# ⚠️  Store secrets securely using your deployment platform's secret manager
# ⚠️  Rotate API keys periodically
# ⚠️  Use HTTPS in production for all endpoints
# ⚠️  Keep SUPABASE_KEY as anon key only (never use service_role key in client)
#
# =============================================================================
